<Window x:Class="NexusBooster.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Booster" Height="900" Width="1440" MinHeight="760" MinWidth="1120"
        WindowStartupLocation="CenterScreen" Background="#0B0D13" Foreground="#F3F4F8">
    <Grid x:Name="RootShell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#10131B" BorderBrush="#202532" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,34">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="N" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="NEXUS" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="BOOSTER" FontSize="9" Foreground="#43E7C3" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="10" Foreground="#6F788A" FontWeight="Bold" Margin="10,0,0,8"/>
                    <Button Style="{StaticResource NavButton}" Content="◈   Dashboard" Click="Dashboard_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="✦   Tweak categories" Click="TweakBrowser_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⌁   Debloat guide" Click="Debloat_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="◉   Mouse profiles" Click="Mouse_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="✧   AI FPS advisor" Click="FpsAdvisor_Click"/>
                    <Button Style="{StaticResource NavButton}" Content="⇩   Official drivers" Click="Drivers_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" CornerRadius="14" Background="#171C27" Padding="14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="SAFETY FIRST" FontSize="10" FontWeight="Bold" Foreground="#43E7C3"/>
                        <TextBlock Text="Every tweak is opt-in. Your original settings are backed up for rollback." TextWrapping="Wrap" Foreground="#9BA3B5" FontSize="11" Margin="0,8,0,0" LineHeight="17"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="34,27,34,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,22">
                <Border DockPanel.Dock="Right" CornerRadius="14" Background="#171C27" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#43E7C3" VerticalAlignment="Center"/>
                        <TextBlock Text="  LOCAL PROFILE" FontSize="10" FontWeight="Bold" Foreground="#B6C0D1" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="Tune your setup with clarity and control." Foreground="#929AAC" Margin="0,5,0,0"/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border CornerRadius="22" Padding="28" Margin="0,0,0,18" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#29204E" Offset="0"/>
                                <GradientStop Color="#1C2944" Offset="0.56"/>
                                <GradientStop Color="#142D35" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="250"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <Border Background="#322B58" CornerRadius="20" Padding="10,5" HorizontalAlignment="Left">
                                    <TextBlock Text="NEXUS CONTROL CENTER" FontSize="9" FontWeight="Bold" Foreground="#C6B8FF"/>
                                </Border>
                                <TextBlock Text="Your rig,&#10;in tune." FontSize="36" FontWeight="Bold" LineHeight="42" Margin="0,15,0,7"/>
                                <TextBlock Text="Small, transparent changes. Always on your terms." Foreground="#B7C0D0" FontSize="14"/>
                                <Button Content="Explore safe tweaks  →" Background="{StaticResource AccentGradient}" HorizontalAlignment="Left" Margin="0,21,0,0" Click="Tweaks_Click"/>
                            </StackPanel>
                            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="170" Height="170">
                                <Ellipse Fill="#278B5CF6" Width="170" Height="170"/>
                                <Ellipse Fill="#1843E7C3" Width="126" Height="126" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border Width="82" Height="82" CornerRadius="25" Background="{StaticResource AccentGradient}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="N" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,0,0,20">
                        <Border CornerRadius="16" Background="#151923" Padding="19" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="APPLIED TWEAKS" FontSize="10" FontWeight="Bold" Foreground="#858FA2"/>
                                <TextBlock x:Name="AppliedCount" Text="0" FontSize="26" FontWeight="Bold" Margin="0,7,0,0"/>
                                <TextBlock Text="with saved rollback points" FontSize="11" Foreground="#929AAC"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="16" Background="#151923" Padding="19" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="PING &amp; NETWORK" FontSize="10" FontWeight="Bold" Foreground="#858FA2"/>
                                <TextBlock Text="Measure first" FontSize="21" FontWeight="Bold" Foreground="#43E7C3" Margin="0,10,0,1"/>
                                <TextBlock Text="No fake ping optimizer tweaks" FontSize="11" Foreground="#929AAC"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="16" Background="#151923" Padding="19" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="YOUR PROFILES" FontSize="10" FontWeight="Bold" Foreground="#858FA2"/>
                                <TextBlock x:Name="ProfileCount" Text="0" FontSize="26" FontWeight="Bold" Margin="0,7,0,0"/>
                                <TextBlock Text="mouse DPI presets saved" FontSize="11" Foreground="#929AAC"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="18" Background="#151923" Padding="22" Margin="0,0,12,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <Button DockPanel.Dock="Right" Content="View all  →" Background="Transparent" Foreground="#BBA8FF" Padding="6,4" Click="Tweaks_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Quick tuning" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="Reversible, account-level Windows settings" FontSize="11" Foreground="#929AAC" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel x:Name="TweakList"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <Border CornerRadius="18" Background="#151923" Padding="22" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Power, USB &amp; Hardware" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Avoid blanket power-bus changes. Some savings settings can affect battery life, heat, or device behavior." TextWrapping="Wrap" Foreground="#AAB2C2" FontSize="12" LineHeight="18" Margin="0,9,0,0"/>
                                    <Button Content="Review safe categories  →" HorizontalAlignment="Left" Margin="0,12,0,0" Background="#242A37" Click="TweakBrowser_Click"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="18" Background="#151923" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Mouse DPI" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="Save your favorite sensitivities as named profiles." TextWrapping="Wrap" Foreground="#9BA3B5" FontSize="12" Margin="0,8,0,13" LineHeight="17"/>
                                    <Button Content="Manage profiles  →" HorizontalAlignment="Left" Background="#242A37" Click="Mouse_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="2" Margin="0,16,0,0">
                        <Border CornerRadius="16" Background="#151923" Padding="18" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="FPS ADVISOR" FontSize="10" FontWeight="Bold" Foreground="#43E7C3"/>
                                <TextBlock Text="Get practical tips for your game and hardware profile." TextWrapping="Wrap" Foreground="#AAB2C2" FontSize="12" Margin="0,7,0,12"/>
                                <Button Content="Open FPS advisor  →" HorizontalAlignment="Left" Background="#242A37" Click="FpsAdvisor_Click"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="16" Background="#151923" Padding="18" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="GPU DRIVER LINKS" FontSize="10" FontWeight="Bold" Foreground="#8FB5FF"/>
                                <TextBlock Text="Find official AMD, NVIDIA, Intel, and MSI support pages." TextWrapping="Wrap" Foreground="#AAB2C2" FontSize="12" Margin="0,7,0,12"/>
                                <Button Content="Browse official drivers  →" HorizontalAlignment="Left" Background="#242A37" Click="Drivers_Click"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border x:Name="DetailPanel" CornerRadius="18" Background="#151923" Padding="22" Margin="0,16,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="DetailBody" Foreground="#AAB2C2" TextWrapping="Wrap" Margin="0,9,0,0" LineHeight="19"/>
                            <StackPanel x:Name="DetailContent" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready · Changes stay on this Windows account." Foreground="#7F899C" FontSize="11" Margin="0,12,0,0"/>
        </Grid>
    </Grid>
</Window>
