<Window x:Class="NexusBooster.Focus.FocusModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Booster · Focus Module" Height="900" Width="1240" MinHeight="760" MinWidth="1000"
        WindowStartupLocation="CenterOwner" Background="#0B0D13" Foreground="#F3F4F8"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Browser blocker files" Click="OpenExtension_Click" Margin="0,0,8,0"/>
                <Button Content="Grayscale settings" Click="ColorFilters_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="NEXUS / FOCUS MODULE" FontSize="10" FontWeight="Bold" Foreground="#43E7C3"/>
                <TextBlock Text="One task. One block. No feed." FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/>
                <TextBlock Text="A separate, local workspace. It does not change Windows policies or lock other apps."
                           Foreground="#929AAC" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border CornerRadius="13" Background="#30271B" Padding="14" Margin="0,0,0,14">
                    <TextBlock Text="Scope: the optional browser extension works only in supported Chromium browsers and listed sites. Nexus does not edit the hosts file, intercept HTTPS, terminate processes, minimize/lock browsers, or enforce break access. IRL check-ins are self-reported."
                               Foreground="#FFD18A" TextWrapping="Wrap" FontSize="11" LineHeight="17"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.88*"/>
                        <ColumnDefinition Width="1.12*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Border CornerRadius="17" Background="#151923" Padding="19" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="TODAY'S ONE-LINE TASK" FontSize="10" FontWeight="Bold" Foreground="#43E7C3"/>
                                <TextBox x:Name="TaskInput" Style="{StaticResource FieldBox}" FontFamily="Consolas" MaxLength="120"
                                         AcceptsReturn="False" Margin="0,10,0,6" TextChanged="TaskInput_TextChanged"/>
                                <TextBlock Text="Keep it specific and under 120 characters. No backlog or folders."
                                           Foreground="#929AAC" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="17" Background="#151923" Padding="19" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="SessionModeText" Text="25-MINUTE FOCUS BLOCK"
                                               FontSize="10" FontWeight="Bold" Foreground="#43E7C3"/>
                                    <TextBlock x:Name="RecoveryBadge" DockPanel.Dock="Right" Text="RECOVERY REQUIRED"
                                               FontSize="9" FontWeight="Bold" Foreground="#FFD18A" Visibility="Collapsed"/>
                                </DockPanel>
                                <TextBlock x:Name="TimerText" Text="25:00" FontSize="42" FontFamily="Consolas"
                                           FontWeight="Bold" Margin="0,12,0,8"/>
                                <TextBlock x:Name="SessionStatusText" Text="Start when your one-line task is ready."
                                           Foreground="#AAB2C2" TextWrapping="Wrap" FontSize="11" LineHeight="16"/>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="StartSessionButton" Content="Start 25 min" Click="StartSession_Click"
                                            Background="{StaticResource AccentGradient}" Margin="0,0,8,0"/>
                                    <Button x:Name="BossSessionButton" Content="Sunday boss · 90 min"
                                            Click="BossSession_Click" IsEnabled="False"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="PauseSessionButton" Content="Pause" Click="PauseSession_Click"
                                            IsEnabled="False" Margin="0,0,8,0"/>
                                    <Button x:Name="CompleteBlockButton" Content="Finalize passed block"
                                            Click="CompleteBlock_Click" IsEnabled="False"/>
                                </StackPanel>
                                <TextBlock Text="Idle detection checks only Windows' last-input timestamp; it does not record keys or mouse movement. At 3 minutes idle the timer pauses and removes the idle interval."
                                           Foreground="#7F899C" FontSize="10" TextWrapping="Wrap" LineHeight="15" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="17" Background="#151923" Padding="19">
                            <StackPanel>
                                <TextBlock Text="REAL-WORLD PROGRESS · LOCAL TOTALS" FontSize="10" FontWeight="Bold" Foreground="#43E7C3"/>
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,8,9">
                                        <TextBlock Text="FOCUS" FontSize="9" Foreground="#858FA2"/>
                                        <TextBlock x:Name="FocusStatText" Text="0 min" FontSize="19" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,9">
                                        <TextBlock Text="INTELLECT · OFFLINE READING" FontSize="9" Foreground="#858FA2"/>
                                        <TextBlock x:Name="IntellectStatText" Text="0 min" FontSize="19" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="BODY · PUSH-UPS / WALK" FontSize="9" Foreground="#858FA2"/>
                                        <TextBlock x:Name="BodyStatText" Text="0 reps · 0 min" FontSize="19" FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="WILLPOWER · SELF-REPORTED" FontSize="9" Foreground="#858FA2"/>
                                        <TextBlock x:Name="WillpowerStatText" Text="0 days" FontSize="19" FontWeight="Bold"/>
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="RankText" Text="Rank 0 · boss sessions completed: 0"
                                           Foreground="#AAB2C2" FontSize="10" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Border CornerRadius="17" Background="#151923" Padding="19" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="ONE-SHOT LOCAL CRITIQUE" FontSize="10" FontWeight="Bold" Foreground="#43E7C3"/>
                                    <TextBlock DockPanel.Dock="Right" Text="NO CHAT · MAX 5 FINDINGS"
                                               FontSize="9" FontWeight="Bold" Foreground="#858FA2"/>
                                </DockPanel>
                                <TextBlock Text="Work to inspect" Foreground="#AAB2C2" FontSize="11" Margin="0,11,0,5"/>
                                <TextBox x:Name="WorkInput" Style="{StaticResource FieldBox}" Height="210"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         TextChanged="WorkInput_TextChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                    <StackPanel Width="260" Margin="0,0,12,0">
                                        <TextBlock Text="Mode" Foreground="#929AAC" FontSize="10"/>
                                        <ComboBox x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged"
                                                  SelectedIndex="0" Margin="0,4,0,0" Padding="8,6"
                                                  Background="#1B202C" Foreground="#F3F4F8"
                                                  BorderBrush="#374052">
                                            <ComboBoxItem Content="Ruthless Code Auditor" Tag="CodeAuditor"/>
                                            <ComboBoxItem Content="Logic &amp; Flaw Hunter" Tag="LogicHunter"/>
                                            <ComboBoxItem Content="Bloat Cutter" Tag="BloatCutter"/>
                                            <ComboBoxItem Content="Goal Alignment Check" Tag="GoalAlignment"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,7">
                                        <TextBlock Text="Local-only model · qwen2.5:1.5b"
                                                   Foreground="#929AAC" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                                <DockPanel Margin="0,11,0,0">
                                    <TextBlock x:Name="CritiqueStatusText" Text="Requires Ollama running locally at 127.0.0.1:11434."
                                               Foreground="#929AAC" FontSize="10" VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="CritiqueButton" DockPanel.Dock="Right" Content="Critique · Ctrl+Shift+C"
                                            Click="Critique_Click" IsEnabled="False" Background="{StaticResource AccentGradient}"
                                            Margin="10,0,0,0"/>
                                </DockPanel>
                                <Border x:Name="CritiqueResultPanel" CornerRadius="12" Background="#10141D"
                                        Padding="13" Margin="0,12,0,0" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="CritiqueVerdictText" FontSize="18" FontWeight="Bold"/>
                                        <StackPanel x:Name="CritiqueBullets" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="17" Background="#151923" Padding="19" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="TODAY'S IRL QUEST" FontSize="10" FontWeight="Bold" Foreground="#43E7C3"/>
                                <TextBlock x:Name="QuestStatusText" Text="Pass one 25-minute block and log 20 push-ups or 15 minutes offline reading."
                                           Foreground="#AAB2C2" TextWrapping="Wrap" FontSize="11" LineHeight="16" Margin="0,7,0,11"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="ReadingMinutesInput" Style="{StaticResource FieldBox}" Width="82" Text="15"/>
                                    <Button Content="Log offline reading · min" Click="LogReading_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <ComboBox x:Name="BodyEffortSelector" SelectedIndex="0" Width="105"
                                              Padding="7,6" Background="#1B202C" Foreground="#F3F4F8"
                                              BorderBrush="#374052">
                                        <ComboBoxItem Content="Push-ups" Tag="PushUps"/>
                                        <ComboBoxItem Content="Walking · min" Tag="Walking"/>
                                    </ComboBox>
                                    <TextBox x:Name="BodyEffortInput" Style="{StaticResource FieldBox}" Width="70"
                                             Text="20" Margin="8,0,0,0"/>
                                    <Button Content="Log effort" Click="LogBodyEffort_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Button x:Name="ShortsFreeButton" Content="Self-report a Shorts-free day"
                                        Click="LogShortsFree_Click" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="17" Background="#151923" Padding="19">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="ZERO-CHROME SCRATCHPAD" FontSize="10" FontWeight="Bold" Foreground="#43E7C3"/>
                                    <Button DockPanel.Dock="Right" Content="Save notes" Click="SaveScratchpad_Click"/>
                                </DockPanel>
                                <TextBox x:Name="ScratchpadInput" Style="{StaticResource FieldBox}" Height="82"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Margin="0,9,0,0" TextChanged="ScratchpadInput_TextChanged"/>
                                <TextBlock Text="Local plain text only. This module is not a Windows lock screen."
                                           Foreground="#7F899C" FontSize="10" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border CornerRadius="13" Background="#151923" Padding="13" Margin="0,14,0,0">
                    <TextBlock Text="Browser support is optional and user-installed. It filters selected distraction paths and removes feed elements; it does not inspect unrelated traffic. See the included extension instructions before loading it."
                               Foreground="#929AAC" TextWrapping="Wrap" FontSize="10" LineHeight="15"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Progress and scratchpad stay in your local Nexus user-data folder."
                   Foreground="#7F899C" FontSize="10" Margin="0,12,0,0"/>
    </Grid>
</Window>
